{
  "name": "Phocos Any-Grid PSW-H (RS-232 / RS-485)",
  "protocol": "phocos-ascii",
  "transport": "rs232",
  "description": "Phocos Any-Grid PSW-H hybrid inverters over the RS-232 port (supplied cable) or RS-485: live readings, mode, fault code and status, plus settings and firmware now and then. Read-only. Needs firmware 06.11 or later.",
  "notes": "Built from Phocos's RS-232 PhocosLink command document (2020-12-14); each request and reply carries a CRC-16/XMODEM. A fault code of 00 is shown as 'No fault' (the document lists no code for it). Reads the directly connected unit (QPGS0); the other units of a parallel system (QPGS1 to QPGS9) are not read yet. Not yet checked against a unit.",
  "defaults": {
    "baud": 2400,
    "dataBits": 8,
    "stopBits": 1,
    "parity": "none"
  },
  "call_order": [
    "QPIGS",
    "QPGS0",
    "QPIRI",
    "QFLAG",
    "QVFW"
  ],
  "commands": [

{
  "name": "Growatt SPH 3-6 kW hybrid (Modbus RTU)",
  "connection": "rtu",
  "defaultUnitId": 1,
  "function": "input",
  "status": "unverified",
  "source": "Growatt PV Inverter Modbus RS485 RTU protocol (V1.39 register numbering), as tabulated in 0xAHA/Growatt_ModbusTCP (MIT), profile SPH_3000_6000, with the community's confirmations on SPH 3600 and SPH 5000. Input registers (function 04); 32-bit values high word first, in units of 0.1. Not the same map as the SPF off-grid series or the MIN/MOD string inverters.",
  "registers": [
    {"metric": "inverter_status", "address": 0, "type": "uint16", "scale": 1, "unit": "", "label": "Inverter Status", "note": "0 = waiting, 1 = normal, 3 = fault"},
    {"metric": "pv_power", "address": 1, "type": "uint32", "scale": 0.1, "unit": "W", "label": "PV Total Power"},
    {"metric": "pv1_voltage", "address": 3, "type": "uint16", "scale": 0.1, "unit": "V", "label": "PV1 Voltage"},
    {"metric": "pv1_current", "address": 4, "type": "uint16", "scale": 0.1, "unit": "A", "label": "PV1 Current"},
    {"metric": "pv1_power", "address": 5, "type": "uint32", "scale": 0.1, "unit": "W", "label": "PV1 Power"},
    {"metric": "pv2_voltage", "address": 7, "type": "uint16", "scale": 0.1, "unit": "V", "label": "PV2 Voltage"},
    {"metric": "pv2_current", "address": 8, "type": "uint16", "scale": 0.1, "unit": "A", "label": "PV2 Current"},
    {"metric": "pv2_power", "address": 9, "type": "uint32", "scale": 0.1, "unit": "W", "label": "PV2 Power"},
    {"metric": "grid_frequency", "address": 37, "type": "uint16", "scale": 0.01, "unit": "Hz", "label": "AC Frequency"},
    {"metric": "grid_voltage", "address": 38, "type": "uint16", "scale": 0.1, "unit": "V", "label": "AC Voltage"},
    {"metric": "grid_current", "address": 39, "type": "uint16", "scale": 0.1, "unit": "A", "label": "AC Current"},
    {"metric": "inverter_power", "address": 40, "type": "uint32", "scale": 0.1, "unit": "W", "label": "AC Output Power"},
    {"metric": "inverter_energy_day", "address": 53, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "Energy Today", "note": "System AC output including battery discharge; the PV-only figure is the sum of the PV1 and PV2 counters below"},
    {"metric": "inverter_energy_total", "address": 55, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "Energy Total"},
    {"metric": "pv1_energy_day", "address": 59, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "PV1 Energy Today"},
    {"metric": "pv1_energy_total", "address": 61, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "PV1 Energy Total"},
    {"metric": "pv2_energy_day", "address": 63, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "PV2 Energy Today"},
    {"metric": "pv2_energy_total", "address": 65, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "PV2 Energy Total"},
    {"metric": "pv_energy_total", "address": 91, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "PV Energy Total"},
    {"metric": "inverter_temp", "address": 93, "type": "int16", "scale": 0.1, "unit": "°C", "label": "Inverter Temperature"},
    {"metric": "ipm_temp", "address": 94, "type": "int16", "scale": 0.1, "unit": "°C", "label": "IPM Temperature"},
    {"metric": "boost_temp", "address": 95, "type": "int16", "scale": 0.1, "unit": "°C", "label": "Boost Temperature"},
    {"metric": "derating_mode", "address": 104, "type": "uint16", "scale": 1, "unit": "", "label": "Derating Mode"},
    {"metric": "fault_code", "address": 105, "type": "uint16", "scale": 1, "unit": "", "label": "Fault Code"},
    {"metric": "ac_charge_energy_day", "address": 112, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "AC Charge Energy Today"},
    {"metric": "ac_charge_energy_total", "address": 114, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "AC Charge Energy Total"},
    {"metric": "battery_discharge_power", "address": 1009, "type": "uint32", "scale": 0.1, "unit": "W", "label": "Battery Discharge Power"},
    {"metric": "battery_charge_power", "address": 1011, "type": "uint32", "scale": 0.1, "unit": "W", "label": "Battery Charge Power"},
    {"metric": "battery_voltage", "address": 1013, "type": "uint16", "scale": 0.1, "unit": "V", "label": "Battery Voltage"},
    {"metric": "battery_soc", "address": 1014, "type": "uint16", "scale": 1, "unit": "%", "label": "Battery State of Charge"},
    {"metric": "battery_temp", "address": 1040, "type": "int16", "scale": 0.1, "unit": "°C", "label": "Battery Temperature"},
    {"metric": "grid_import_power_r", "address": 1015, "type": "uint32", "scale": 0.1, "unit": "W", "label": "Grid Import Power (R phase)"},
    {"metric": "grid_import_power", "address": 1021, "type": "uint32", "scale": 0.1, "unit": "W", "label": "Grid Import Power", "note": "Total AC power to the user, which is what the house draws from the grid"},
    {"metric": "grid_export_power", "address": 1029, "type": "int32", "scale": 0.1, "unit": "W", "label": "Grid Export Power", "note": "Positive means exporting"},
    {"metric": "load_power", "address": 1037, "type": "uint32", "scale": 0.1, "unit": "W", "label": "Load Power", "note": "Inverter power to the local load"},
    {"metric": "grid_import_energy_day", "address": 1044, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "Grid Import Energy Today"},
    {"metric": "grid_import_energy_total", "address": 1046, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "Grid Import Energy Total"},
    {"metric": "grid_export_energy_day", "address": 1048, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "Grid Export Energy Today"},
    {"metric": "grid_export_energy_total", "address": 1050, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "Grid Export Energy Total", "note": "One owner found this lifetime total disagreed with the Growatt portal; check it against yours"},
    {"metric": "battery_discharge_energy_day", "address": 1052, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "Battery Discharge Energy Today"},
    {"metric": "battery_discharge_energy_total", "address": 1054, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "Battery Discharge Energy Total"},
    {"metric": "battery_charge_energy_day", "address": 1056, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "Battery Charge Energy Today"},
    {"metric": "battery_charge_energy_total", "address": 1058, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "Battery Charge Energy Total"},
    {"metric": "load_energy_day", "address": 1060, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "Load Energy Today"},
    {"metric": "load_energy_total", "address": 1062, "type": "uint32", "scale": 0.1, "unit": "kWh", "label": "Load Energy Total"},
    {"metric": "battery_current", "address": 1088, "type": "int16", "scale": 0.01, "unit": "A", "label": "Battery Current", "note": "Signed, from the BMS"},
    {"metric": "bms_cycle_count", "address": 1095, "type": "uint16", "scale": 1, "unit": "", "label": "BMS Cycle Count"},
    {"metric": "battery_soh", "address": 1096, "type": "uint16", "scale": 1, "unit": "%", "label": "BMS State of Health"},
    {"metric": "bms_max_cell_voltage", "address": 1108, "type": "uint16", "scale": 0.001, "unit": "V", "label": "Max Cell Voltage"},
    {"metric": "bms_min_cell_voltage", "address": 1109, "type": "uint16", "scale": 0.001, "unit": "V", "label": "Min Cell Voltage"}
  ]
}

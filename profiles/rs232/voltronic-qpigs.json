{
  "name": "Voltronic / Axpert (QPIGS ASCII)",
  "protocol": "voltronic-qpigs",
  "transport": "rs232",
  "defaults": {
    "baud": 2400,
    "dataBits": 8,
    "stopBits": 1,
    "parity": "none"
  },
  "commands": [
    {
      "name": "QPIGS",
      "query": "QPIGS\r\n",
      "response": {
        "type": "ascii-line",
        "prefix": "(",
        "delimiter": " "
      },
      "fields": [
        {"index": 0, "metric": "grid_voltage", "scale": 1, "unit": "V", "label": "Grid Voltage"},
        {"index": 1, "metric": "grid_frequency", "scale": 0.01, "unit": "Hz", "label": "Grid Frequency"},
        {"index": 2, "metric": "output_voltage", "scale": 1, "unit": "V", "label": "AC Output Voltage"},
        {"index": 3, "metric": "output_frequency", "scale": 0.01, "unit": "Hz", "label": "AC Output Frequency"},
        {"index": 4, "metric": "output_va", "scale": 1, "unit": "VA", "label": "AC Output Apparent Power"},
        {"index": 5, "metric": "output_power", "scale": 1, "unit": "W", "label": "AC Output Active Power"},
        {"index": 6, "metric": "load_percent", "scale": 1, "unit": "%", "label": "Output Load Percent"},
        {"index": 7, "metric": "bus_voltage", "scale": 0.1, "unit": "V", "label": "DC Bus Voltage"},
        {"index": 8, "metric": "battery_voltage", "scale": 0.1, "unit": "V", "label": "Battery Voltage"},
        {"index": 9, "metric": "battery_charge_current", "scale": 1, "unit": "A", "label": "Battery Charging Current"},
        {"index": 10, "metric": "battery_soc", "scale": 1, "unit": "%", "label": "Battery SOC"},
        {"index": 11, "metric": "inverter_temp", "scale": 1, "unit": "°C", "label": "Inverter Heatsink Temperature"},
        {"index": 12, "metric": "pv_current", "scale": 1, "unit": "A", "label": "PV Input Current"},
        {"index": 13, "metric": "pv_voltage", "scale": 0.1, "unit": "V", "label": "PV Input Voltage"},
        {"index": 14, "metric": "battery_scc_voltage", "scale": 0.1, "unit": "V", "label": "Battery Voltage (SCC)"},
        {"index": 15, "metric": "battery_discharge_current", "scale": 1, "unit": "A", "label": "Battery Discharge Current"},
        {"index": 16, "metric": "device_status", "scale": 1, "unit": "", "label": "Device Status Flags"}
      ]
    },
    {
      "name": "QMOD",
      "query": "QMOD\r\n",
      "response": {
        "type": "ascii-char",
        "prefix": "("
      },
      "fields": [
        {"index": 0, "metric": "inverter_mode", "scale": 1, "unit": "", "type": "mode-char", "label": "Inverter Mode"}
      ]
    }
  ]
}

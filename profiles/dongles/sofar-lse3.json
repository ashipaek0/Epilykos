{
  "name": "Sofar LSE-3 (Modbus TCP)",
  "transport": "modbus-tcp",
  "requires_serial": false,
  "default_port": 8899,
  "default_unit_id": 1,
  "metrics": [
    {
      "name": "solar_power",
      "register": "0x0004",
      "count": 1,
      "type": "uint16",
      "scale": 10,
      "unit": "W",
      "field": "solar_power",
      "label": "Solar Power"
    },
    {
      "name": "grid_power",
      "register": "0x000C",
      "count": 1,
      "type": "int16",
      "scale": 10,
      "unit": "W",
      "field": "grid_power",
      "label": "Grid Power"
    },
    {
      "name": "load_power",
      "register": "0x000E",
      "count": 1,
      "type": "uint16",
      "scale": 10,
      "unit": "W",
      "field": "load_power",
      "label": "Load Power"
    },
    {
      "name": "battery_soc",
      "register": "0x010C",
      "count": 1,
      "type": "uint16",
      "scale": 1,
      "unit": "%",
      "field": "battery_soc",
      "label": "Battery SOC"
    },
    {
      "name": "battery_voltage",
      "register": "0x010D",
      "count": 1,
      "type": "uint16",
      "scale": 0.1,
      "unit": "V",
      "field": "battery_voltage",
      "label": "Battery Voltage"
    },
    {
      "name": "battery_current",
      "register": "0x010E",
      "count": 1,
      "type": "int16",
      "scale": 0.1,
      "unit": "A",
      "field": "battery_current",
      "label": "Battery Current"
    },
    {
      "name": "daily_solar",
      "register": "0x0204",
      "count": 1,
      "type": "uint16",
      "scale": 0.1,
      "unit": "kWh",
      "field": "daily_solar",
      "label": "Daily Solar"
    },
    {
      "name": "total_solar",
      "register": "0x0200",
      "count": 2,
      "type": "uint32",
      "scale": 0.1,
      "unit": "kWh",
      "field": "total_solar",
      "label": "Total Solar"
    },
    {
      "name": "solar_voltage",
      "register": "0x0006",
      "count": 1,
      "type": "uint16",
      "scale": 0.1,
      "unit": "V",
      "field": "solar_voltage",
      "label": "Solar Voltage"
    },
    {
      "name": "inverter_temperature",
      "register": "0x000F",
      "count": 1,
      "type": "uint16",
      "scale": 0.1,
      "unit": "\u00b0C",
      "field": "inverter_temperature",
      "label": "Inverter Temperature"
    }
  ]
}

      "register": "0x1306",
      "count": 1,
      "type": "uint16",
      "scale": 0.01,
      "unit": "V",
      "field": "pack_voltage",
      "label": "Pack Voltage"
    },
    {
      "name": "pack_current",
      "register": "0x1307",
      "count": 1,
      "type": "int16",
      "scale": 0.1,
      "unit": "A",
      "field": "pack_current",
      "label": "Pack Current (negative=charge, positive=discharge)"
    },
    {

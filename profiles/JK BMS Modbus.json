{
  "name": "JK‑BMS (Modbus)",
  "defaultUnitId": 1,
  "registers": [
    { "metric": "battery_voltage",    "address": 4752, "type": "uint32", "scale": 0.001, "unit": "V" },
    { "metric": "battery_current",    "address": 4760, "type": "int32",  "scale": 0.001, "unit": "A" },
    { "metric": "battery_power",      "address": 4756, "type": "int32",  "scale": 0.001, "unit": "W" },
    { "metric": "battery_soc",        "address": 4774, "type": "uint16", "comment": "low byte is SOC %" },
    { "metric": "battery_soh",        "address": 4792, "type": "uint16", "comment": "high byte is SOH %" },
    { "metric": "bms_cycle_count",    "address": 4784, "type": "uint32", "scale": 1.0,  "unit": "cycles" },
    { "metric": "bms_temp_mosfet",    "address": 4746, "type": "int16",  "scale": 0.1,  "unit": "°C" },
    { "metric": "bms_temp_sensor1",   "address": 4764, "type": "int16",  "scale": 0.1,  "unit": "°C" },
    { "metric": "bms_temp_sensor2",   "address": 4766, "type": "int16",  "scale": 0.1,  "unit": "°C" }
  ]
}

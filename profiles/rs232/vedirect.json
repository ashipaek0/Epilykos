{
  "name": "Victron VE.Direct",
  "protocol": "vedirect-streaming",
  "transport": "rs232",
  "defaults": {
    "baud": 19200,
    "dataBits": 8,
    "stopBits": 1,
    "parity": "none"
  },
  "fields": [
    {
      "label": "Battery Voltage",
      "metric": "battery_voltage",
      "type": "millivolt",
      "unit": "V"
    },
    {
      "label": "Battery Current",
      "metric": "battery_current",
      "type": "milliamp",
      "unit": "A"
    },
    {
      "label": "Solar Voltage",
      "metric": "solar_voltage",
      "scale": 0.01,
      "unit": "V"
    },
    {
      "label": "Solar Power",
      "metric": "solar_power",
      "scale": 1,
      "unit": "W"
    },
    {
      "label": "Battery SOC",
      "metric": "battery_soc",
      "scale": 0.1,
      "unit": "%"
    },
    {
      "label": "Battery Temp",
      "metric": "battery_temp",
      "scale": 0.1,
      "unit": "°C"
    },
    {
      "label": "Daily Yield",
      "metric": "daily_yield",
      "scale": 0.01,
      "unit": "kWh"
    },
    {
      "label": "Daily Yield Load",
      "metric": "daily_yield_load",
      "scale": 0.01,
      "unit": "kWh"
    },
    {
      "label": "Total Yield",
      "metric": "total_yield",
      "scale": 0.01,
      "unit": "kWh"
    },
    {
      "label": "Total Yield Load",
      "metric": "total_yield_load",
      "scale": 0.01,
      "unit": "kWh"
    },
    {
      "label": "Day Sequence",
      "metric": "day_sequence",
      "scale": 1,
      "unit": ""
    },
    {
      "label": "MPPT Mode",
      "metric": "mppt_mode",
      "scale": 1,
      "unit": "",
      "type": "mode"
    },
    {
      "label": "Load State",
      "metric": "load_state",
      "scale": 1,
      "unit": "",
      "type": "bool"
    },
    {
      "label": "Charge State",
      "metric": "charge_state",
      "scale": 1,
      "unit": "",
      "type": "mode"
    }
  ]
}

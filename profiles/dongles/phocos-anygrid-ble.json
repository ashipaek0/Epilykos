{
  "name": "Phocos Any-Grid PSW-H (Bluetooth)",
  "protocol": "ble-gatt",
  "transport": "ble-gatt",
  "connection": "bluetooth",
  "read_only": false,
  "capabilities": { "read": true, "write": true },
  "default_poll_interval": 15,
  "description": "Phocos Any-Grid PSW-H BLE telemetry and settings. Writes use allowlisted, read/compare/write/readback transactions; hardware acceptance remains unverified.",
  "notes": "Static PhocosLink 2.1.4 analysis. App-confirmed SOC, discharge and charging current; temperature, PV current, bus voltage and apparent power remain inferred. No live firmware validation.",
  "blocks": [
    { "id": "live", "service": "1810", "characteristic": "2a03", "length": 20 },
    { "id": "status", "service": "1810", "characteristic": "2a04", "length": 20 },
    { "id": "pv1", "service": "1811", "characteristic": "2a11", "length": 20 },
    { "id": "pv2", "service": "1811", "characteristic": "2a12", "length": 20 },
    { "id": "identity_firmware", "service": "1810", "characteristic": "2a01", "length": 20, "optional": true },
    { "id": "identity_serial", "service": "1810", "characteristic": "2a02", "length": 20, "optional": true },
    { "id": "ratings", "service": "1810", "characteristic": "2a05", "length": 20, "optional": true },
    { "id": "settings_flags", "service": "1810", "characteristic": "2a0d", "length": 20, "optional": true }
  ],
  "settingBlocks": [
    { "id": "settings_2a0c", "service": "1810", "characteristic": "2a0c", "length": 20 },
    { "id": "settings_2a0d", "service": "1810", "characteristic": "2a0d", "length": 20 },
    { "id": "settings_2a0e", "service": "1810", "characteristic": "2a0e", "minimumLength": 2, "optional": true }
  ],
  "settings": [
    { "id": "output_voltage", "label": "AC output voltage", "type": "enum", "unit": "V", "characteristic": "2a0c", "field": "output_voltage", "offset": 0, "scale": 1, "allowed": [110,120,127,220,230,240], "writable": true },
    { "id": "output_frequency", "label": "AC output frequency", "type": "enum", "unit": "Hz", "characteristic": "2a0c", "field": "output_frequency", "offset": 2, "scale": 10, "allowed": [50,60], "writable": true },
    { "id": "max_charging_current", "label": "Maximum charging current", "type": "number", "unit": "A", "characteristic": "2a0c", "field": "max_charging_current", "offset": 4, "scale": 1, "min": 0, "max": 120, "step": 1, "writable": true },
    { "id": "max_utility_charging_current", "label": "Maximum utility charging current", "type": "number", "unit": "A", "characteristic": "2a0c", "field": "max_utility_charging_current", "offset": 5, "scale": 1, "min": 0, "max": 120, "step": 1, "writable": true },
    { "id": "float_voltage", "label": "Float voltage", "type": "number", "unit": "V", "characteristic": "2a0c", "field": "float_voltage", "offset": 6, "scale": 10, "min": 24, "max": 56, "step": 0.1, "writable": true },
    { "id": "boost_voltage", "label": "Boost voltage", "type": "number", "unit": "V", "characteristic": "2a0c", "field": "boost_voltage", "offset": 8, "scale": 10, "min": 24, "max": 56, "step": 0.1, "writable": true },
    { "id": "disconnect_voltage", "label": "Low voltage disconnect", "type": "number", "unit": "V", "characteristic": "2a0c", "field": "disconnect_voltage", "offset": 10, "scale": 10, "min": 18.8, "max": 54, "step": 0.1, "writable": true },
    { "id": "recharge_voltage", "label": "Recharge voltage", "type": "number", "unit": "V", "characteristic": "2a0c", "field": "recharge_voltage", "offset": 12, "scale": 10, "min": 22, "max": 57, "step": 0.1, "writable": true },
    { "id": "input_range", "label": "AC input range", "type": "enum", "characteristic": "2a0c", "field": "input_range", "offset": 16, "allowed": [0,1], "writable": true },
    { "id": "output_priority", "label": "Output source priority", "type": "enum", "characteristic": "2a0c", "field": "output_priority", "offset": 17, "allowed": [0,1,2], "writable": true },
    { "id": "charger_priority", "label": "Charger source priority", "type": "enum", "characteristic": "2a0c", "field": "charger_priority", "offset": 18, "allowed": [1,2,3], "writable": true },
    { "id": "battery_type", "label": "Battery type", "type": "enum", "characteristic": "2a0c", "field": "battery_type", "offset": 19, "allowed": [0,1,2,3,4,5,6,7], "writable": true },
    { "id": "record_fault_codes", "label": "Record fault codes", "characteristic": "2a0d", "field": "record_fault_codes", "type": "boolean", "writable": true },
    { "id": "alarm_source_interrupted", "label": "Alarm when primary source interrupted", "characteristic": "2a0d", "field": "alarm_source_interrupted", "type": "boolean", "writable": true },
    { "id": "lcd_backlight", "label": "Display backlight", "characteristic": "2a0d", "field": "lcd_backlight", "type": "boolean", "writable": true },
    { "id": "restart_overtemperature", "label": "Restart after overtemperature", "characteristic": "2a0d", "field": "restart_overtemperature", "type": "boolean", "writable": true },
    { "id": "restart_overload", "label": "Restart after overload", "characteristic": "2a0d", "field": "restart_overload", "type": "boolean", "writable": true },
    { "id": "lcd_auto_return", "label": "Auto-return display", "characteristic": "2a0d", "field": "lcd_auto_return", "type": "boolean", "writable": true },
    { "id": "solar_feed_grid", "label": "Solar feed to grid", "characteristic": "2a0d", "field": "solar_feed_grid", "type": "boolean", "writable": true },
    { "id": "overload_bypass", "label": "Overload bypass", "characteristic": "2a0d", "field": "overload_bypass", "type": "boolean", "writable": true },
    { "id": "buzzer", "label": "Buzzer", "characteristic": "2a0d", "field": "buzzer", "type": "boolean", "writable": true },
    { "id": "battery_equalization", "label": "Battery equalization", "characteristic": "2a0d", "field": "battery_equalization", "type": "boolean", "writable": true },
    { "id": "equalization_duration", "label": "Equalization duration", "type": "number", "unit": "min", "characteristic": "2a0d", "field": "equalization_duration", "offset": 6, "scale": 1, "min": 5, "max": 120, "step": 1, "writable": true },
    { "id": "equalization_interval", "label": "Equalization interval", "type": "number", "unit": "days", "characteristic": "2a0d", "field": "equalization_interval", "offset": 8, "scale": 1, "min": 0, "max": 90, "step": 1, "writable": true },
    { "id": "equalization_voltage", "label": "Equalization voltage", "type": "number", "unit": "V", "writable": false, "reason": "Read/write scaling is asymmetric in the app evidence." },
    { "id": "equalization_timeout", "label": "Equalization timeout", "type": "number", "unit": "min", "characteristic": "2a0d", "field": "equalization_timeout", "offset": 12, "scale": 1, "min": 5, "max": 900, "step": 1, "writable": true },
    { "id": "force_equalization", "label": "Force equalization", "type": "boolean", "writable": false, "reason": "Not decoded by the app; semantics unresolved." },
    { "id": "boost_duration", "label": "Boost charge duration", "type": "number", "unit": "min", "characteristic": "2a0d", "field": "boost_duration", "offset": 16, "scale": 1, "min": 5, "max": 900, "step": 1, "writable": true },
    { "id": "discharge_current", "label": "Maximum discharge current", "characteristic": "2a0e", "field": "discharge_current", "offset": 1, "type": "number", "unit": "A", "min": 0, "max": 150, "step": 1, "writable": true }
  ],
  "derived": [
    { "name": "pv_power", "sum": ["pv1[7]", "pv2[7]"] },
    { "name": "battery_discharge_power", "product": ["live[8]", "status[2]"] }
  ],
  "fields": [
    { "name": "grid_voltage",              "path": "live[0]",   "scale": 0.1,  "unit": "V",  "label": "Grid Voltage" },
    { "name": "grid_frequency",            "path": "live[1]",   "scale": 0.1,  "unit": "Hz", "label": "Grid Frequency" },
    { "name": "output_voltage",            "path": "live[2]",   "scale": 0.1,  "unit": "V",  "label": "AC Output Voltage" },
    { "name": "output_frequency",          "path": "live[3]",   "scale": 0.1,  "unit": "Hz", "label": "AC Output Frequency" },
    { "name": "output_va",                 "path": "live[4]",   "scale": 1,    "unit": "VA", "label": "AC Output Apparent Power" },
    { "name": "output_power",              "path": "live[5]",   "scale": 1,    "unit": "W",  "label": "AC Output Active Power" },
    { "name": "load_percent",              "path": "live[6]",   "scale": 1,    "unit": "%",  "label": "Output Load Percent" },
    { "name": "bus_voltage",               "path": "live[7]",   "scale": 1,    "unit": "V",  "label": "DC Bus Voltage" },
    { "name": "battery_voltage", "path": "live[8]", "scale": 0.01, "unit": "V", "label": "Battery Voltage" },
    { "name": "battery_charging_current", "path": "live[9]", "scale": 1, "unit": "A", "confidence": "app_confirmed", "label": "Battery Charging Current" },
    { "name": "operating_mode", "path": "operating_mode", "type": "string", "unit": "", "confidence": "app_confirmed", "label": "Operating Mode" },
    { "name": "battery_soc", "path": "status[0]", "scale": 1, "unit": "%", "confidence": "app_confirmed", "label": "Battery SOC" },
    { "name": "inverter_temp",             "path": "status[1]", "scale": 1,    "unit": "°C", "confidence": "inferred", "label": "Inverter Heatsink Temperature (inferred)" },
    { "name": "battery_discharge_current", "path": "status[2]", "scale": 1, "unit": "A", "confidence": "app_confirmed", "label": "Battery Discharge Current" },
    { "name": "pv1_current",               "path": "pv1[5]",    "scale": 0.1,  "unit": "A",  "confidence": "inferred", "label": "PV1 Current (inferred)" },
    { "name": "pv1_voltage",               "path": "pv1[6]",    "scale": 0.1,  "unit": "V",  "label": "PV1 Voltage" },
    { "name": "pv1_power",                 "path": "pv1[7]",    "scale": 1,    "unit": "W",  "label": "PV1 Power" },
    { "name": "pv2_current",               "path": "pv2[5]",    "scale": 0.1,  "unit": "A",  "confidence": "inferred", "label": "PV2 Current (inferred)" },
    { "name": "pv2_voltage",               "path": "pv2[6]",    "scale": 0.1,  "unit": "V",  "label": "PV2 Voltage" },
    { "name": "pv2_power",                 "path": "pv2[7]",    "scale": 1,    "unit": "W",  "label": "PV2 Power" },
    { "name": "pv_power",                  "path": "derived.pv_power", "scale": 1, "unit": "W", "label": "PV Power (PV1 + PV2)" },
    { "name": "battery_discharge_power",   "path": "derived.battery_discharge_power", "scale": 0.01, "unit": "W", "label": "Battery Discharge Power (voltage × discharge current)" }
  ]
}

# Epilykos Environment Variables
# Copy this file to .env and fill in your values

# Required: Password for accessing settings/editor (dashboard auth)
SETTINGS_PASSWORD=your_secure_password_here

# Optional: Override default port (default: 3000)
# PORT=3000

# Optional: Session secret for persistence across restarts
# If unset, a random secret is generated and saved to data/session-secret
# SESSION_SECRET=your_session_secret_here

# Optional: Bluetooth (BMS + inverter Bluetooth modules) runs inside the main
# container and needs the host D-Bus socket mounted (/run/dbus:/run/dbus:ro).
# Set BLUETOOTH=off to disable it entirely.
# BLUETOOTH=on

# Deprecated: use a separately deployed legacy bms-bridge sidecar instead of the
# built-in Bluetooth support. Leave unset for new installs.
# BMS_BRIDGE_URL=http://172.17.0.1:8020

# Optional: Log level — debug, info, warn, error (default: info)
# LOG_LEVEL=info

# Optional: Timezone (default: system timezone)
# TZ=Africa/Lagos

# Optional: write rotating log files under logs/ (default: true).
# Set false to log to stdout/stderr only — needed for a read-only container
# root (EpilykosOS appliance, where journald collects the logs).
# LOG_TO_FILE=true
# LOG_DIR=/app/logs

# Optional: SQLite durability — NORMAL (default), FULL or EXTRA. OFF is refused.
# NORMAL never corrupts the database on power loss but can drop the last few
# seconds of writes; FULL syncs every commit at some write-speed cost.
# SQLITE_SYNCHRONOUS=NORMAL

# Optional: temporary directory for uploads (backup restore, layout import).
# TMPDIR=/tmp

# Optional: the dashboard, editor and Controls pages are served as one bundled
# script each (built in memory at start-up, no build step). Set 0 to serve the
# individual files instead, e.g. when debugging the page code.
# EPILYKOS_BUNDLE=1

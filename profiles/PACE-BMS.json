{
  "name": "PACE BMS (RS485)",
  "defaultUnitId": 1,
  "registers": [
    { "metric": "battery_current",    "address": 0,  "type": "int16",  "scale": 0.01, "unit": "A" },
    { "metric": "battery_voltage",    "address": 1,  "type": "uint16", "scale": 0.01, "unit": "V" },
    { "metric": "battery_soc",        "address": 2,  "type": "uint16", "scale": 1.0,  "unit": "%" },
    { "metric": "battery_soh",        "address": 3,  "type": "uint16", "scale": 1.0,  "unit": "%" },
    { "metric": "bms_cycle_count",    "address": 7,  "type": "uint16", "scale": 1.0,  "unit": "cycles" },
    { "metric": "bms_temp_mosfet",    "address": 53, "type": "int16",  "scale": 0.1,  "unit": "°C" },
    { "metric": "bms_temp_sensor1",   "address": 49, "type": "int16",  "scale": 0.1,  "unit": "°C" },
    { "metric": "bms_temp_sensor2",   "address": 51, "type": "int16",  "scale": 0.1,  "unit": "°C" }
  ]
}
